# Shopify App
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-url.com
SCOPES=read_inventory,write_inventory,read_products,write_products,read_locations,read_customers,write_customers

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bh_shopify_app?schema=public"

# ERP Configuration (defaults - can be overridden per shop in settings)
ERP_BASE_URL=https://your-erp-api.com
ERP_API_KEY=your_erp_api_key
ERP_API_HEADER=X-Api-Key

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
WEBHOOK_SECRET=your_webhook_secret_for_erp_calls
