@page "/app/sync-log"
@model BhShopifyApp.Pages.App.SyncLogModel
@{
    ViewData["Title"] = "Historial de Sincronización";
}

<div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
    <a href="/app" class="btn btn-secondary btn-sm">← Volver</a>
    <h1 style="margin:0">Historial de Sincronización</h1>
    <span style="color:#6d7175;font-size:14px">@Model.Total registros</span>
</div>

<!-- Filters -->
<div class="card" style="padding:12px 16px">
    <form method="get">
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <select class="form-control" name="direction" style="width:180px"
                    onchange="this.form.submit()">
                <option value="">Todas las direcciones</option>
                <option value="ShopifyToErp" @(Model.Direction == "ShopifyToErp" ? "selected":"")>
                    Shopify → ERP
                </option>
                <option value="ErpToShopify" @(Model.Direction == "ErpToShopify" ? "selected":"")>
                    ERP → Shopify
                </option>
            </select>
            <select class="form-control" name="status" style="width:150px"
                    onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="Success" @(Model.Status == "Success" ? "selected":"")>Exitoso</option>
                <option value="Failed"  @(Model.Status == "Failed"  ? "selected":"")>Fallido</option>
                <option value="Skipped" @(Model.Status == "Skipped" ? "selected":"")>Omitido</option>
            </select>
            <input class="form-control" type="text" name="sku" value="@Model.SkuFilter"
                   placeholder="Filtrar por SKU..." style="width:200px" />
            <button type="submit" class="btn btn-secondary btn-sm">Filtrar</button>
            <a href="/app/sync-log" class="btn btn-secondary btn-sm">Limpiar</a>
        </div>
    </form>
</div>

<div class="card" style="padding:0">
    @if (!Model.Logs.Any())
    {
        <div style="padding:40px;text-align:center;color:#6d7175">
            No hay registros para los filtros seleccionados.
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Dirección</th>
                    <th>SKU ERP</th>
                    <th>Variant ID</th>
                    <th>Antes</th>
                    <th>Después</th>
                    <th>Estado</th>
                    <th>Origen</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td style="white-space:nowrap">
                            @log.CreatedAt.ToString("dd/MM/yy HH:mm:ss")
                        </td>
                        <td>
                            @if (log.Direction == SyncDirection.ShopifyToErp)
                            { <span class="badge badge-info">Shopify → ERP</span> }
                            else
                            { <span class="badge badge-warning">ERP → Shopify</span> }
                        </td>
                        <td><code>@(log.ErpSku ?? "—")</code></td>
                        <td><small>@(log.ShopifyVariantId?.Split('/').Last() ?? "—")</small></td>
                        <td>@(log.QuantityBefore?.ToString() ?? "—")</td>
                        <td>@(log.QuantityAfter?.ToString() ?? "—")</td>
                        <td>
                            @{
                                var (cls, lbl) = log.Status switch
                                {
                                    SyncStatus.Success => ("badge-success", "Exitoso"),
                                    SyncStatus.Failed  => ("badge-danger",  "Fallido"),
                                    _                  => ("badge-secondary","Omitido"),
                                };
                            }
                            <span class="badge @cls">@lbl</span>
                        </td>
                        <td><small>@log.Source</small></td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.ErrorMessage))
                            {
                                <small style="color:#d72c0d" title="@log.ErrorMessage">
                                    @(log.ErrorMessage.Length > 40
                                      ? log.ErrorMessage[..40] + "…"
                                      : log.ErrorMessage)
                                </small>
                            }
                            else { <span>—</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div style="padding:16px;display:flex;gap:8px;justify-content:center">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    var active = i == Model.Page ? "btn-primary" : "btn-secondary";
                    <a href="?page=@i&direction=@Model.Direction&status=@Model.Status&sku=@Model.SkuFilter"
                       class="btn @active btn-sm">@i</a>
                }
            </div>
        }
    }
</div>
