@page "/app"
@model BhShopifyApp.Pages.App.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 style="margin-bottom:20px">Dashboard — Sincronización ERP</h1>

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">
        ⚠️ <strong>Configura tu ERP primero.</strong>
        <a href="/app/settings">Ir a Configuración →</a>
    </div>
}

@if (TempData["SyncResult"] is string syncMsg)
{
    <div class="alert alert-success">@syncMsg</div>
}
@if (TempData["SyncError"] is string syncErr)
{
    <div class="alert alert-danger">@syncErr</div>
}

<!-- Stats -->
<div class="stat-grid" style="margin-bottom:20px">
    <div class="stat-card">
        <div style="color:#6d7175;font-size:13px">TOTAL SINCRONIZACIONES</div>
        <div class="stat-number">@Model.Stats.Total</div>
    </div>
    <div class="stat-card">
        <div style="color:#6d7175;font-size:13px">EXITOSAS</div>
        <div class="stat-number" style="color:#008060">@Model.Stats.Success</div>
    </div>
    <div class="stat-card">
        <div style="color:#6d7175;font-size:13px">FALLIDAS</div>
        <div class="stat-number" style="color:#d72c0d">@Model.Stats.Failed</div>
    </div>
</div>

<div class="two-col">
    <!-- Status Card -->
    <div class="card">
        <h2>Estado del Sistema</h2>
        <table>
            <tr>
                <td>Sincronización automática</td>
                <td>
                    @if (Model.Stats.SyncEnabled)
                    {
                        <span class="badge badge-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactiva</span>
                    }
                </td>
            </tr>
            <tr>
                <td>Última sincronización</td>
                <td>@(Model.Stats.LastSyncAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
            </tr>
            <tr>
                <td>Cola pendiente</td>
                <td>
                    <span class="badge @(Model.Stats.PendingQueue > 0 ? "badge-warning" : "badge-success")">
                        @Model.Stats.PendingQueue pendientes
                    </span>
                </td>
            </tr>
        </table>

        <br />
        <form method="post" asp-page-handler="FullSync">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" @(!Model.IsConfigured ? "disabled" : "")>
                🔄 Sincronizar Todo Ahora
            </button>
        </form>
    </div>

    <!-- Quick Links -->
    <div class="card">
        <h2>Acciones Rápidas</h2>
        <div style="display:flex;flex-direction:column;gap:10px">
            <a href="/app/products" class="btn btn-secondary">📦 Mapeo de Productos</a>
            <a href="/app/sync-log" class="btn btn-secondary">📋 Ver Historial</a>
            <a href="/app/settings" class="btn btn-secondary">⚙️ Configurar ERP</a>
        </div>
    </div>
</div>

<!-- Recent Logs -->
<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <h2 style="margin:0">Actividad Reciente</h2>
        <a href="/app/sync-log" class="btn btn-secondary btn-sm">Ver todo</a>
    </div>

    @if (!Model.RecentLogs.Any())
    {
        <p style="color:#6d7175;text-align:center;padding:20px 0">
            Sin actividad aún. Configure el ERP para comenzar.
        </p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Fecha</th><th>Dirección</th><th>SKU ERP</th>
                    <th>Antes</th><th>Después</th><th>Estado</th><th>Origen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.RecentLogs)
                {
                    <tr>
                        <td>@log.CreatedAt.ToString("dd/MM HH:mm:ss")</td>
                        <td>
                            @if (log.Direction == SyncDirection.ShopifyToErp)
                            {
                                <span class="badge badge-info">Shopify → ERP</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">ERP → Shopify</span>
                            }
                        </td>
                        <td>@(log.ErpSku ?? "—")</td>
                        <td>@(log.QuantityBefore?.ToString() ?? "—")</td>
                        <td>@(log.QuantityAfter?.ToString() ?? "—")</td>
                        <td>
                            @{
                                var (cls, lbl) = log.Status switch
                                {
                                    SyncStatus.Success => ("badge-success", "Exitoso"),
                                    SyncStatus.Failed  => ("badge-danger",  "Fallido"),
                                    _                  => ("badge-secondary","Omitido"),
                                };
                            }
                            <span class="badge @cls">@lbl</span>
                        </td>
                        <td>@log.Source</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
