@page "/app/settings"
@model BhShopifyApp.Pages.App.SettingsModel
@{
    ViewData["Title"] = "Configuración ERP";
}

<div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
    <a href="/app" class="btn btn-secondary btn-sm">← Volver</a>
    <h1 style="margin:0">Configuración ERP</h1>
</div>

@if (TempData["Success"] is string msg)   { <div class="alert alert-success">✅ @msg</div> }
@if (TempData["Error"] is string err)     { <div class="alert alert-danger">❌ @err</div> }
@if (Model.TestResult is not null)
{
    var cls = Model.TestResult.Success ? "alert-success" : "alert-danger";
    var ico = Model.TestResult.Success ? "✅" : "❌";
    <div class="alert @cls">@ico @Model.TestResult.Message</div>
}

<div class="two-col">
    <!-- Main Form -->
    <div class="card">
        <h2>Conexión al ERP</h2>
        <form method="post" asp-page-handler="Save">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>URL Base del ERP <span style="color:red">*</span></label>
                <input class="form-control" type="url" name="ErpBaseUrl"
                       value="@Model.Settings?.ErpBaseUrl"
                       placeholder="https://tu-erp.com" required />
                <small style="color:#6d7175">URL base de tu API REST C#. Ej: https://erp.miempresa.com</small>
            </div>
            <div class="form-group">
                <label>API Key <span style="color:red">*</span></label>
                <input class="form-control" type="password" name="ErpApiKey"
                       value="@Model.Settings?.ErpApiKey"
                       placeholder="••••••••" required />
            </div>
            <div class="form-group">
                <label>Header de Autenticación</label>
                <input class="form-control" type="text" name="ErpApiHeader"
                       value="@(Model.Settings?.ErpApiHeader ?? "X-Api-Key")"
                       placeholder="X-Api-Key" />
                <small style="color:#6d7175">
                    Nombre del header donde se envía la API Key.
                    Usa <code>Authorization</code> para Bearer tokens (formato: <code>Bearer {key}</code>).
                </small>
            </div>

            <hr style="border:none;border-top:1px solid #e1e3e5;margin:20px 0"/>
            <h3 style="margin-top:0">Sincronización Automática</h3>

            <div class="form-check">
                <input type="checkbox" name="SyncEnabled" value="true" id="syncEnabled"
                       @(Model.Settings?.SyncEnabled != false ? "checked" : "") />
                <label for="syncEnabled">Activar sincronización periódica (cron)</label>
            </div>

            <div class="form-group">
                <label>Intervalo de sincronización</label>
                <select class="form-control" name="SyncIntervalMinutes">
                    @foreach (var opt in new[] { 5, 15, 30, 60, 120 })
                    {
                        var sel = (Model.Settings?.SyncIntervalMinutes ?? 15) == opt ? "selected" : "";
                        <option value="@opt" @sel>@opt minutos</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">💾 Guardar Configuración</button>
        </form>
    </div>

    <!-- Side Panel -->
    <div>
        <div class="card">
            <h2>Probar Conexión</h2>
            <p style="color:#6d7175;font-size:14px">
                Verifica la URL y API Key antes de guardar.
            </p>
            <form method="post" asp-page-handler="Test">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ErpBaseUrl" value="@Model.Settings?.ErpBaseUrl" />
                <input type="hidden" name="ErpApiKey" value="@Model.Settings?.ErpApiKey" />
                <input type="hidden" name="ErpApiHeader" value="@Model.Settings?.ErpApiHeader" />
                <button type="submit" class="btn btn-secondary">🔌 Probar Conexión</button>
            </form>
        </div>

        <div class="card">
            <h2>Endpoint para el ERP</h2>
            <p style="color:#6d7175;font-size:13px">
                Configura tu ERP C# para enviar cambios a:
            </p>
            <code>POST /api/erp-webhook</code>
            <br/><br/>
            <p style="font-size:13px">Headers requeridos:</p>
            <pre>X-Webhook-Secret: {WEBHOOK_SECRET}
X-Shop-Domain: {tu-tienda.myshopify.com}</pre>
            <p style="font-size:13px">Body (individual o batch):</p>
            <pre>{ "sku": "PROD-001", "quantity": 50 }

// o batch:
{ "items": [
  { "sku": "PROD-001", "quantity": 50 },
  { "sku": "PROD-002", "quantity": 10 }
] }</pre>
        </div>
    </div>
</div>
